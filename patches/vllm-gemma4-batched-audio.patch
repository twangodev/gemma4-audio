diff --git a/vllm/model_executor/models/gemma4_mm.py b/vllm/model_executor/models/gemma4_mm.py
index f21dde9..b2e55fd 100644
--- a/vllm/model_executor/models/gemma4_mm.py
+++ b/vllm/model_executor/models/gemma4_mm.py
@@ -1465,8 +1465,28 @@ class Gemma4ForConditionalGeneration(
         self,
         audio_input: Gemma4AudioInputs,
     ) -> list[torch.Tensor]:
-        input_features = audio_input["input_features_padded"].squeeze(1)
-        input_features_mask = audio_input["input_features_mask"].squeeze(1)
+        ifp = audio_input["input_features_padded"]
+        ifm = audio_input["input_features_mask"]
+        if isinstance(ifp, (list, tuple)):
+            # Ragged batch: vLLM passes a list of per-audio [frames_i, dim]
+            # tensors when frame counts differ. Pad to a common length and
+            # stack so the audio tower (which processes a [N, frames, dim]
+            # batch) gets a real tensor; padded frames are masked out below.
+            # (Upstream assumed a single stacked tensor and called
+            # ``.squeeze(1)``, which crashes with AttributeError on the list.)
+            feats = [f.reshape(-1, f.shape[-1]) for f in ifp]
+            msks = [m.reshape(-1) for m in ifm]
+            max_len = max(f.shape[0] for f in feats)
+            input_features = feats[0].new_zeros(
+                len(feats), max_len, feats[0].shape[-1]
+            )
+            input_features_mask = msks[0].new_zeros(len(msks), max_len)
+            for i, (f, m) in enumerate(zip(feats, msks, strict=True)):
+                input_features[i, : f.shape[0]] = f
+                input_features_mask[i, : m.shape[0]] = m
+        else:
+            input_features = ifp.squeeze(1)
+            input_features_mask = ifm.squeeze(1)
 
         # Run audio tower — mask convention: True=valid, False=padding.
         audio_outputs = self.audio_tower(input_features, input_features_mask)
diff --git a/vllm/model_executor/models/gemma4_unified.py b/vllm/model_executor/models/gemma4_unified.py
